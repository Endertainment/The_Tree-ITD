[node name="FreeStatus" type="Label" parent="Margin/Content/FreeCard/Values"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HudSmall"
text = "0 / 3 today"

[node name="FreeButton" type="Button" parent="Margin/Content/FreeCard/Values"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)

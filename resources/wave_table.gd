class_name WaveTable
extends Resource
## Authored wave data for the first ten waves.
##
## Groups are stored flat and tagged with `wave`; `entries_for()` returns the
## groups of one wave sorted by `start_delay`. Waves 11+ are generated by
## `WaveManager` from templates, not stored here.

@export var id: String = "main"
@export var entries: Array[WaveEntry] = []


## Returns the spawn groups of `wave`, ordered by their start delay.
func entries_for(wave: int) -> Array[WaveEntry]:
	var result: Array[WaveEntry] = []
	for entry: WaveEntry in entries:
		if entry != null and entry.wave == wave:
			result.append(entry)
	result.sort_custom(_sort_by_delay)
	return result


## Highest authored wave, or 0 when the table is empty.
func max_authored_wave() -> int:
	var highest := 0
	for entry: WaveEntry in entries:
		if entry != null:
			highest = maxi(highest, entry.wave)
	return highest


func _sort_by_delay(a: WaveEntry, b: WaveEntry) -> bool:
	if is_equal_approx(a.start_delay, b.start_delay):
		return a.enemy_id < b.enemy_id
	return a.start_delay < b.start_delay
